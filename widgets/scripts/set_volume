#!/bin/bash
set -euo pipefail

# Resolve the sibling audio helper with Bash path expansion, avoiding an
# external dirname process and a command-substitution shell.
SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="${SCRIPT_PATH%/*}"
[[ "$SCRIPT_DIR" != "$SCRIPT_PATH" ]] || SCRIPT_DIR=.
source "$SCRIPT_DIR/audio/common.sh"

mode="${1:-}"
value="${2:-}"

if [[ ! "$value" =~ ^[0-9]+$ ]] || (( value < 0 || value > 100 )); then
    exit 2
fi

case "$mode" in
    main)
        set_main_volume "$value"
        case "${3:-}" in
            "") ;;
            unmute) set_main_mute 0 ;;
            *) exit 2 ;;
        esac
        ;;
    stream)
        id="${3:-}"
        [[ "$id" =~ ^[0-9]+$ ]] || exit 2
        if command -v pactl >/dev/null 2>&1; then
            pactl set-sink-input-volume "$id" "${value}%"
        else
            exit 127
        fi
        ;;
    *)
        exit 2
        ;;
esac
