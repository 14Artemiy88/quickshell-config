#!/bin/bash
set -o pipefail
source "$(dirname "$0")/env"

declare -r CACHE_DIR="/tmp/weather_cache"
declare -r CACHE_TTL=600  # 10 минут
declare -r CURL_CONNECT_TIMEOUT=5
declare -r CURL_MAX_TIME=10
SETTINGS_FILE="$QS_CONFIG_DIR/settings.json"
GISMETEO_TOKEN="$(jq -r ".weatherToken // \"\"" "$SETTINGS_FILE" 2>/dev/null || true)"
if [[ -z "$GISMETEO_TOKEN" ]]; then
  echo "Ошибка: токен Gismeteo не задан" >&2
  exit 1
fi


# Создаем директорию кэша
mkdir -p "$CACHE_DIR"

function get_weather() {
    local cache=$1
    local type=$2
    local params=$3
    local force=${4:-false}
    local cache_file="$CACHE_DIR/${cache}_${params//[^a-z0-9]/_}.json"

    # Проверяем актуальность кэша, если запрос не принудительный.
    if [[ "$force" != "true" && -f "$cache_file" && $(($(date +%s) - $(stat -c %Y "$cache_file"))) -lt $CACHE_TTL ]]; then
        cat "$cache_file"
        return
    fi

    # Выполняем запрос с жёстким таймаутом и кэшируем только валидный ответ.
    local tmp_file
    tmp_file=$(mktemp "${cache_file}.XXXXXX") || return 1
    if ! curl -sfS --connect-timeout "$CURL_CONNECT_TIMEOUT" --max-time "$CURL_MAX_TIME" \
         -H "X-Gismeteo-Token: $GISMETEO_TOKEN" \
         "https://api.gismeteo.net/v2/weather/$type/4517/$params" |
         jq -c '.response | select(. != null)' > "$tmp_file"; then
        rm -f "$tmp_file"
        return 1
    fi

    if [[ ! -s "$tmp_file" ]] || ! jq -e '((type == "object") or (type == "array"))' "$tmp_file" >/dev/null 2>&1; then
        rm -f "$tmp_file"
        return 1
    fi

    mv -f "$tmp_file" "$cache_file"
    cat "$cache_file"
}

# Остальная часть скрипта без изменений
case $1 in
    now)  get_weather "now" "current" "" "$([[ "${2:-}" == "--force" ]] && echo true || echo false)" ;;
    day)  get_weather "day" "forecast" "?days=2" "$([[ "${2:-}" == "--force" ]] && echo true || echo false)" ;;
    week) get_weather "week" "forecast/aggregate" "?days=5" "$([[ "${2:-}" == "--force" ]] && echo true || echo false)" ;;
    *)    echo "Usage: $0 {now|day|week}" >&2; exit 1 ;;
esac
