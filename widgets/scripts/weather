#!/bin/bash
set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/weather.d/common.sh"
source "$SCRIPT_DIR/weather.d/gismeteo.sh"

mkdir -p "$WEATHER_CACHE_DIR"

get_weather() {
    local cache_name="$1"
    local endpoint_type="$2"
    local params="$3"
    local force="${4:-false}"
    local cache_file
    cache_file=$(weather_cache_file "$cache_name" "$params")

    local token
    token=$(weather_require_token) || return 1

    if [[ "$force" != "true" ]] && weather_cache_valid "$cache_file"; then
        weather_cache_read "$cache_file"
        return 0
    fi

    local payload
    payload=$(weather_gismeteo_fetch "$token" "$endpoint_type" "$params") || return 1
    [[ -n "$payload" ]] || return 1

    weather_cache_write "$cache_file" "$payload" || return 1
    printf '%s\n' "$payload"
}

case "${1:-}" in
    now)
        get_weather "now" "current" "" "$([[ "${2:-}" == "--force" ]] && echo true || echo false)"
        ;;
    day)
        get_weather "day" "forecast" "?days=2" "$([[ "${2:-}" == "--force" ]] && echo true || echo false)"
        ;;
    week)
        get_weather "week" "forecast/aggregate" "?days=5" "$([[ "${2:-}" == "--force" ]] && echo true || echo false)"
        ;;
    *)
        echo "Usage: $0 {now|day|week} [--force]" >&2
        exit 1
        ;;
esac
