#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/env"
CFG_DIR="$QS_CONFIG_DIR"
FILE="$CFG_DIR/calendar-notes.json"
mkdir -p "$CFG_DIR"
[[ -f "$FILE" ]] || printf '{}\n' > "$FILE"

case "${1:-get}" in
  get)
    jq -e 'if type == "object" then . else {} end' "$FILE"
    ;;
  set)
    key="${2:-}"
    value="${3:-}"
    if [[ ! "$key" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
      echo "Invalid date key; expected YYYY-MM-DD" >&2
      exit 2
    fi
    tmp="$(mktemp "$CFG_DIR/.calendar-notes.XXXXXX")"
    trap 'rm -f "$tmp"' EXIT
    if [[ -z "$(printf '%s' "$value" | tr -d '[:space:]')" ]]; then
      jq --arg key "$key" 'del(.[$key])' "$FILE" > "$tmp"
    else
      jq --arg key "$key" --arg value "$value" '.[$key] = $value' "$FILE" > "$tmp"
    fi
    mv "$tmp" "$FILE"
    trap - EXIT
    ;;
  *)
    echo "Usage: $0 {get|set YYYY-MM-DD TEXT}" >&2
    exit 2
    ;;
esac
