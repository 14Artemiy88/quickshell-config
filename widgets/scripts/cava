#!/bin/bash

normalize_integer() {
    local value="$1"
    local fallback="$2"
    local minimum="$3"
    local maximum="$4"

    if [[ ! "$value" =~ ^[0-9]+$ ]]; then
        printf '%s' "$fallback"
        return
    fi

    if (( value < minimum || value > maximum )); then
        printf '%s' "$fallback"
    else
        printf '%s' "$value"
    fi
}

bars="$(normalize_integer "${1:-75}" 75 8 120)"
framerate="$(normalize_integer "${2:-30}" 30 1 120)"

cava_config() {
    cat <<CAVA
[general]
framerate=$framerate
bars=$bars
[output]
method=raw
raw_target=/dev/stdout
data_format=ascii
ascii_max_range=100
channels=mono
noise_reduction=0.5
CAVA
}

cava_config \
    | cava -p /dev/stdin \
    | sed -u 's/;$//; s/;/,/g' \
    | awk '{print "[" $0 "]"; fflush()}'
