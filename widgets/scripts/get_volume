#!/bin/bash
set -euo pipefail

if command -v wpctl >/dev/null 2>&1; then
    wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{v=$2*100; if (/MUTED/) v=0; printf "%d\n", v+0.5; exit}'
    exit 0
fi

if command -v pactl >/dev/null 2>&1; then
    pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk 'NR==1 { for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+%$/) { gsub(/%/, "", $i); print $i; exit } }'
    exit 0
fi

if command -v amixer >/dev/null 2>&1; then
    amixer -D pulse sget Master 2>/dev/null | awk -F"[][]" '/Left:/ { if (/on\]/) { gsub(/%/, "", $2); print $2; exit } if (/off\]/) { print 0; exit } }'
    exit 0
fi

printf '0\n'
