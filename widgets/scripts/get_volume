#!/bin/bash
set -euo pipefail

# Resolve the audio helper with Bash path expansion; this polling entry point
# avoids a dirname process and command-substitution shell on every refresh.
SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="${SCRIPT_PATH%/*}"
[[ "$SCRIPT_DIR" != "$SCRIPT_PATH" ]] || SCRIPT_DIR=.
source "$SCRIPT_DIR/audio/common.sh"

get_main_volume
