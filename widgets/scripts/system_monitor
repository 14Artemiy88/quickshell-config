#!/bin/bash
source "$(dirname "$0")/env"
source "$(dirname "$0")/system_monitor.d/common.sh"
source "$(dirname "$0")/system_monitor.d/network_stat.sh"
source "$(dirname "$0")/system_monitor.d/top_apps.sh"
source "$(dirname "$0")/system_monitor.d/volumes.sh"
source "$(dirname "$0")/system_monitor.d/network_connections.sh"

STATE_NET="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/desktop-shell-net"
CACHE_NET="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/desktop-shell-net_cache"
CACHE_NET_TIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/desktop-shell-net_cache_time"
TMPD=$(mktemp -d)
trap 'rm -rf "$TMPD"' EXIT

WANT_TOP_APPS="${1:-1}"
WANT_NET_STAT="${2:-1}"
WANT_VOLUMES="${3:-1}"
WANT_NETWORK="${4:-1}"

if [[ "$WANT_NET_STAT" == "1" ]]; then
    get_network_stat "$STATE_NET" > "$TMPD/net" &
else
    printf '{"down":"0 B","up":"0 B","speed_down":"0 B","speed_up":"0 B"}' > "$TMPD/net"
fi

if [[ "$WANT_TOP_APPS" == "1" ]]; then
    get_top_apps > "$TMPD/top" &
else
    printf '{"cpu":[],"mem":[]}' > "$TMPD/top"
fi

if [[ "$WANT_VOLUMES" == "1" ]]; then
    get_volumes > "$TMPD/vol" &
else
    printf '[]' > "$TMPD/vol"
fi

if [[ "$WANT_NETWORK" == "1" ]]; then
    get_network_connections "$CACHE_NET" "$CACHE_NET_TIME" > "$TMPD/netw" &
else
    printf '[]' > "$TMPD/netw"
fi
wait

jq -n \
    --argjson top_apps "$(cat "$TMPD/top")" \
    --argjson net_stat "$(cat "$TMPD/net")" \
    --argjson volumes "$(cat "$TMPD/vol")" \
    --argjson network "$(cat "$TMPD/netw")" \
    '{top_apps:$top_apps,net_stat:$net_stat,volumes:$volumes,network:$network}'
