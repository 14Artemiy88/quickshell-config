#!/bin/bash
set -u
# Resolve the script's sibling paths without spawning dirname or a subshell.
SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="${SCRIPT_PATH%/*}"
[[ "$SCRIPT_DIR" != "$SCRIPT_PATH" ]] || SCRIPT_DIR=.
source "$SCRIPT_DIR/cpu_stats.d/common.sh"
PROC_STAT="${CPU_STATS_PROC_STAT:-/proc/stat}"
# CpuWidget passes a sample window derived from its configured poll cadence.
# Keep direct/scripted invocations compatible with CPU_STATS_SAMPLE_INTERVAL.
SAMPLE_INTERVAL="${CPU_STATS_SAMPLE_INTERVAL:-0.25}"
if [[ "${1:-}" =~ ^[0-9]+$ ]] && (( 10#$1 >= 50 && 10#$1 <= 250 )); then
  printf -v SAMPLE_INTERVAL '0.%03d' "$((10#$1))"
elif [[ ! "$SAMPLE_INTERVAL" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  SAMPLE_INTERVAL="0.25"
fi

before="$(cpu_read_counters_with_ids "$PROC_STAT" 2>/dev/null || true)"
sleep "$SAMPLE_INTERVAL"
after="$(cpu_read_counters_with_ids "$PROC_STAT" 2>/dev/null || true)"
pct_snapshot="$(cpu_usage_snapshot_percentages "$before" "$after")"

out="["
first=1
while read -r cpu pct; do
  [[ "${cpu:-}" =~ ^cpu[0-9]+$ && "${pct:-}" =~ ^[0-9]+$ ]] || continue
  (( first )) || out+=","; first=0
  out+="$pct"
done <<< "$pct_snapshot"
out+="]"
ram="$(mem_usage_percent /proc/meminfo)"
printf '{"cpu":%s,"ram":%s}\n' "$out" "${ram:-0}"
