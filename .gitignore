.migration-calendar-notes-v1
.migration-calendar-marks-v1
.settings.json.corrupt.*
.settings.json.backup-corrupt.*
.profiles.json.corrupt.*
.secrets.json.corrupt.*
settings.json.before-launcher-project-recovery-*
calendar-notes.json
calendar-marks.json

# Recoverable journal for an interrupted settings/profile transaction
.settings-profile-transaction
.settings-profile-transaction.*
