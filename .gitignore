# Storage sidecars must stay local even when settings/profiles are stored in a
# nested directory inside a Git checkout. The primary settings.json and
# profiles.json remain intentionally trackable for configuration sync.
.settings.json.bak
.profiles.json.bak
.secrets.json.bak
.settings.lock
.profiles.lock
.storage-paths.conf
.storage-paths.lock
.calendar-notes.lock
.calendar-marks.lock
