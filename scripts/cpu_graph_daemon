#!/bin/bash
SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="${SCRIPT_PATH%/*}"
if [[ "$SCRIPT_DIR" == "$SCRIPT_PATH" ]]; then
    SCRIPT_DIR='.'
elif [[ -z "$SCRIPT_DIR" ]]; then
    SCRIPT_DIR='/'
fi
source "$SCRIPT_DIR/cpu_stats.d/common.sh"

STATE="${CPU_GRAPH_STATE:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/desktop-shell-cpu-graph}"
PROC_STAT="${CPU_GRAPH_PROC_STAT:-/proc/stat}"
INTERVAL="${CPU_GRAPH_INTERVAL:-1}"
LINES=51

prev_busy=0 prev_total=0
has_prev=0
hist=""
delta_total=0 delta_busy=0

# State v2 stores exactly the shared helper's busy/total counters. When an old
# four-counter state is encountered, preserve valid history but take a fresh
# baseline to avoid a false spike from incompatible counters.
if [[ -f "$STATE" ]]; then
    # Read both state lines in the current shell. The old separate `sed -n 2p`
    # launched a process only to fetch the history row during daemon startup.
    {
        IFS=' ' read -r state_version state_busy state_total || true
        IFS= read -r hist || true
    } < "$STATE"
    if [[ "${state_version:-}" == "v2" && "${state_busy:-}" =~ ^[0-9]+$ && "${state_total:-}" =~ ^[0-9]+$ ]] && \
       (( 10#$state_total > 0 && 10#$state_busy <= 10#$state_total )); then
        prev_busy="$state_busy"
        prev_total="$state_total"
        has_prev=1
    fi
fi

# Resolve the state directory once instead of launching `dirname` on every
# graph refresh. If the directory is removed while the daemon is running, the
# loop recreates it only when needed.
case "$STATE" in
    */*) state_dir="${STATE%/*}"; [[ -n "$state_dir" ]] || state_dir='/' ;;
    *) state_dir='.' ;;
esac

# History must contain exactly 51 integer samples in [0,100]. A partial write
# or old malformed state is ignored instead of poisoning the graph forever.
history_valid=1
if [[ "$hist" =~ ^[0-9]+(,[0-9]+){50}$ ]]; then
    IFS=',' read -r -a history_values <<< "$hist"
    for history_value in "${history_values[@]}"; do
        # Compare as decimal after removing leading zeroes, avoiding Bash's
        # octal interpretation and keeping arithmetic bounded to 0..100.
        history_value="${history_value#"${history_value%%[!0]*}"}"
        [[ -n "$history_value" ]] || history_value=0
        if [[ ! "$history_value" =~ ^[0-9]+$ ]] || \
           (( ${#history_value} > 3 )) || \
           { (( ${#history_value} == 3 )) && (( 10#$history_value > 100 )); }; then
            history_valid=0
            break
        fi
    done
else
    history_valid=0
fi
if (( ! history_valid )); then
    hist=""
fi

while true; do
    # Read into this shell's variable directly. Capturing the compatibility
    # helper's stdout with command substitution used to create one Bash
    # subshell per graph sample, even though the shared reader already exposes
    # a caller-variable API for this hot path.
    counters=''
    cpu_read_aggregate_counters_into counters "$PROC_STAT" 2>/dev/null || counters=''
    read -r busy total <<< "$counters"
    if [[ ! "${busy:-}" =~ ^[0-9]+$ || ! "${total:-}" =~ ^[0-9]+$ ]]; then
        # A transiently unreadable /proc/stat sample is not a real zero-load
        # sample. Preserve both the graph history and the last valid baseline;
        # the next valid delta will naturally cover the longer elapsed interval.
        if [[ -z "$hist" ]]; then
            hist="0"
            for ((i=2; i<=LINES; i++)); do hist="$hist,0"; done
        fi
        printf '[%s]\n' "$hist"
        sleep "$INTERVAL"
        continue
    fi
    has_valid_counters=1

    pct=0
    if (( has_prev )); then
        # Keep this one-second hot path in the daemon shell rather than using
        # a command substitution to call cpu_usage_percent (one subshell per tick).
        delta_total=$((total - prev_total))
        delta_busy=$((busy - prev_busy))
        if (( delta_total > 0 && delta_busy >= 0 )); then
            pct=$((delta_busy * 100 / delta_total))
            (( pct < 0 )) && pct=0
            (( pct > 100 )) && pct=100
        fi
    fi

    if [[ -z "$hist" ]]; then
        hist="0"
        for ((i=2; i<=LINES; i++)); do hist="$hist,0"; done
    fi
    hist="${hist#*,},$pct"

    # Publish the state as a single atomic replacement so a restarting daemon
    # never observes a truncated first line or a history line from another tick.
    # mktemp already creates a private 0600 file, so chmod would only add a
    # subprocess to every graph refresh. Avoid mkdir unless the state directory
    # was removed or could not be created on an earlier tick.
    if [[ -d "$state_dir" ]] || mkdir -p "$state_dir" 2>/dev/null; then
        state_tmp=$(mktemp "${STATE}.tmp.XXXXXX" 2>/dev/null || true)
        if [[ -n "$state_tmp" ]]; then
            if printf 'v2 %s %s\n%s\n' "$busy" "$total" "$hist" > "$state_tmp" && \
               mv -f -- "$state_tmp" "$STATE"; then
                :
            else
                rm -f -- "$state_tmp" 2>/dev/null || true
            fi
        fi
    fi

    printf '[%s]\n' "$hist"

    prev_busy=$busy
    prev_total=$total
    has_prev=$has_valid_counters

    sleep "$INTERVAL"
done
