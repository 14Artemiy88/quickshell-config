#!/bin/bash
# Paths used by quickshell-widgets follow the XDG Base Directory Specification.
# Keep the installed/source tree separate from user data: assets and scripts
# are project files, not a writable settings directory.
# Resolve the project root from this sourced file using Bash built-ins. `env`
# is sourced by frequently polled scripts (Player/System Monitor/timer); the
# former dirname + cd/pwd command substitution spawned processes each time.
if [[ -z "${QS_PROJECT_DIR:-}" ]]; then
    _qs_env_source_path="${BASH_SOURCE[0]}"
    [[ "$_qs_env_source_path" == /* ]] || _qs_env_source_path="$PWD/$_qs_env_source_path"
    _qs_env_rest="${_qs_env_source_path#/}"
    _qs_env_components=()
    while [[ -n "$_qs_env_rest" ]]; do
        if [[ "$_qs_env_rest" == */* ]]; then
            _qs_env_component="${_qs_env_rest%%/*}"
            _qs_env_rest="${_qs_env_rest#*/}"
        else
            _qs_env_component="$_qs_env_rest"
            _qs_env_rest=''
        fi
        case "$_qs_env_component" in
            ''|.) ;;
            ..)
                _qs_env_count=${#_qs_env_components[@]}
                if ((_qs_env_count > 0)); then
                    _qs_env_last=$((_qs_env_count - 1))
                    if [[ "${_qs_env_components[$_qs_env_last]}" != ".." ]]; then
                        unset "_qs_env_components[$_qs_env_last]"
                    else
                        _qs_env_components+=("..")
                    fi
                fi
                ;;
            *) _qs_env_components+=("$_qs_env_component") ;;
        esac
    done

    # env always lives at <project>/scripts/env. Remove those final two path
    # components after normalizing '.', '..' and repeated slashes.
    _qs_env_count=${#_qs_env_components[@]}
    if ((_qs_env_count >= 2)); then
        unset "_qs_env_components[$((_qs_env_count - 1))]"
        _qs_env_count=$((_qs_env_count - 1))
        unset "_qs_env_components[$((_qs_env_count - 1))]"
    fi
    QS_PROJECT_DIR=''
    for _qs_env_component in "${_qs_env_components[@]}"; do
        QS_PROJECT_DIR+="/$_qs_env_component"
    done
    [[ -n "$QS_PROJECT_DIR" ]] || QS_PROJECT_DIR='/'
    unset _qs_env_source_path _qs_env_rest _qs_env_components _qs_env_component _qs_env_count _qs_env_last
fi

# XDG base variables are only valid when absolute; fall back to spec defaults
# if an invalid relative path was inherited from the desktop environment.
_xdg_config_home="${XDG_CONFIG_HOME:-}"
_xdg_data_home="${XDG_DATA_HOME:-}"
_xdg_state_home="${XDG_STATE_HOME:-}"
_xdg_cache_home="${XDG_CACHE_HOME:-}"
[[ "$_xdg_config_home" == /* ]] || _xdg_config_home="$HOME/.config"
[[ "$_xdg_data_home" == /* ]] || _xdg_data_home="$HOME/.local/share"
[[ "$_xdg_state_home" == /* ]] || _xdg_state_home="$HOME/.local/state"
[[ "$_xdg_cache_home" == /* ]] || _xdg_cache_home="$HOME/.cache"
_qs_legacy_quickshell_dir="$_xdg_config_home/quickshell"

QS_CONFIG_DIR="${QS_CONFIG_DIR:-$_xdg_config_home/quickshell-widgets}"
QS_DATA_DIR="${QS_DATA_DIR:-$_xdg_data_home/quickshell-widgets}"
QS_STATE_DIR="${QS_STATE_DIR:-$_xdg_state_home/quickshell-widgets}"
QS_CACHE_DIR="${QS_CACHE_DIR:-$_xdg_cache_home/quickshell-widgets}"
unset _xdg_config_home _xdg_data_home _xdg_state_home _xdg_cache_home
export QS_PROJECT_DIR QS_CONFIG_DIR QS_DATA_DIR QS_STATE_DIR QS_CACHE_DIR
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# New user directories should be private because settings can contain API tokens.
umask 077
# `env` is sourced by the short-lived Player poll and several other frequently
# called scripts. Once the XDG directories exist, avoid starting `mkdir` on
# every invocation; still create all missing directories on first use.
if [[ ! -d "$QS_CONFIG_DIR" || ! -d "$QS_DATA_DIR" || ! -d "$QS_STATE_DIR" || ! -d "$QS_CACHE_DIR" ]]; then
    mkdir -p "$QS_CONFIG_DIR" "$QS_DATA_DIR" "$QS_STATE_DIR" "$QS_CACHE_DIR" 2>/dev/null || true
fi

# These three user-editable JSON files may be moved independently. The small
# path registry stays in the canonical config directory so moving settings.json
# does not move the pointer needed to find it again. XDG/QS_CONFIG_DIR/QS_DATA_DIR
# determine the defaults; this registry is the single source for per-file paths.
_qs_storage_paths_registry="$QS_CONFIG_DIR/.storage-paths.conf"

qs_refresh_storage_file_paths() {
    local _qs_path_line _qs_saved_path
    QS_SETTINGS_FILE="$QS_CONFIG_DIR/settings.json"
    QS_PROFILES_FILE="${QS_SETTINGS_FILE%/*}/profiles.json"
    QS_CALENDAR_NOTES_FILE="$QS_DATA_DIR/calendar-notes.json"
    QS_CALENDAR_MARKS_FILE="$QS_DATA_DIR/calendar-marks.json"
    if [[ -r "$_qs_storage_paths_registry" ]]; then
        while IFS= read -r _qs_path_line || [[ -n "$_qs_path_line" ]]; do
            case "$_qs_path_line" in
                settings=*)
                    _qs_saved_path="${_qs_path_line#settings=}"
                    if [[ "$_qs_saved_path" == /* ]]; then QS_SETTINGS_FILE="$_qs_saved_path"; fi
                    ;;
                profiles=*)
                    _qs_saved_path="${_qs_path_line#profiles=}"
                    if [[ "$_qs_saved_path" == /* ]]; then QS_PROFILES_FILE="$_qs_saved_path"; fi
                    ;;
                calendarNotes=*)
                    _qs_saved_path="${_qs_path_line#calendarNotes=}"
                    if [[ "$_qs_saved_path" == /* ]]; then QS_CALENDAR_NOTES_FILE="$_qs_saved_path"; fi
                    ;;
                calendarMarks=*)
                    _qs_saved_path="${_qs_path_line#calendarMarks=}"
                    if [[ "$_qs_saved_path" == /* ]]; then QS_CALENDAR_MARKS_FILE="$_qs_saved_path"; fi
                    ;;
            esac
        done < "$_qs_storage_paths_registry"
    fi
}
qs_refresh_storage_file_paths
# File paths are local to each script sourcing env. Do not export the resolved
# values: a child process must reread the registry so queued operations can
# notice a path move that happened while they waited for a file lock.
export -n QS_SETTINGS_FILE QS_PROFILES_FILE QS_CALENDAR_NOTES_FILE QS_CALENDAR_MARKS_FILE 2>/dev/null || true

# Migrate legacy files only when a canonical destination does not exist.
# Source files are deliberately retained as rollback copies. If the current
# project directory has no legacy file, look for older Quickshell installs.
_qs_migrate_json_if_missing() {
    local legacy="$1" destination="$2" kind="$3" temp marker destination_dir
    destination_dir="${destination%/*}"
    [[ "$destination_dir" != "$destination" ]] || destination_dir=.
    marker="$destination_dir/.migration-${kind}-v1"
    [[ -e "$marker" ]] && return 0
    # A canonical file always wins. Mark the migration as complete so deleting
    # that file later (for a reset) cannot resurrect a stale legacy copy.
    if [[ -e "$destination" ]]; then
        : > "$marker" 2>/dev/null || true
        chmod 600 "$marker" 2>/dev/null || true
        return 0
    fi
    [[ "$legacy" != "$destination" && -f "$legacy" ]] || return 0
    command -v jq >/dev/null 2>&1 || return 0
    case "$kind" in
        settings)
            jq -e 'type == "object" and (.modules.time? != null) and (.modules.timer? != null) and ((.geometry? | type) == "object")' "$legacy" >/dev/null 2>&1 || return 0
            ;;
        calendar-notes)
            jq -e 'type == "object"' "$legacy" >/dev/null 2>&1 || return 0
            ;;
        *) return 0 ;;
    esac
    mkdir -p "$(dirname "$destination")" 2>/dev/null || return 0
    temp=$(mktemp "${destination}.migrate.XXXXXX" 2>/dev/null) || return 0
    if ! cp "$legacy" "$temp" 2>/dev/null; then
        rm -f "$temp"
        return 0
    fi
    chmod 600 "$temp" 2>/dev/null || true
    mv -n "$temp" "$destination" 2>/dev/null || true
    if [[ -e "$temp" ]]; then rm -f "$temp"; fi
    if [[ -e "$destination" ]]; then
        : > "$marker" 2>/dev/null || true
        chmod 600 "$marker" 2>/dev/null || true
    fi
}

_qs_migrate_json_if_missing "$QS_PROJECT_DIR/settings.json" "$QS_SETTINGS_FILE" settings
if [[ ! -f "$QS_SETTINGS_FILE" ]]; then
    for _qs_old in "$_qs_legacy_quickshell_dir/desktop-shell/settings.json" "$_qs_legacy_quickshell_dir"/*/settings.json; do
        [[ -f "$_qs_old" ]] || continue
        _qs_migrate_json_if_missing "$_qs_old" "$QS_SETTINGS_FILE" settings
        [[ -f "$QS_SETTINGS_FILE" ]] && break
    done
fi

_qs_migrate_json_if_missing "$QS_PROJECT_DIR/calendar-notes.json" "$QS_CALENDAR_NOTES_FILE" calendar-notes
if [[ ! -f "$QS_CALENDAR_NOTES_FILE" ]]; then
    for _qs_old in "$_qs_legacy_quickshell_dir/desktop-shell/calendar-notes.json" "$_qs_legacy_quickshell_dir"/*/calendar-notes.json; do
        [[ -f "$_qs_old" ]] || continue
        _qs_migrate_json_if_missing "$_qs_old" "$QS_CALENDAR_NOTES_FILE" calendar-notes
        [[ -f "$QS_CALENDAR_NOTES_FILE" ]] && break
    done
fi
unset -f _qs_migrate_json_if_missing
unset _qs_legacy_quickshell_dir _qs_old
