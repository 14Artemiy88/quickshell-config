#!/usr/bin/env bash
set -euo pipefail

image="${1-}"
output_name="${2-}"
screen_index="${3-}"

if [[ -z "$image" || ! -f "$image" || ! -r "$image" ]]; then
    printf 'set_wallpaper: image file not found or unreadable\n' >&2
    exit 2
fi
if [[ -z "$output_name" ]]; then
    printf 'set_wallpaper: target monitor is required\n' >&2
    exit 2
fi
if [[ ! "$screen_index" =~ ^[0-9]+$ ]]; then
    printf 'set_wallpaper: invalid target screen index\n' >&2
    exit 2
fi

current_desktop="${XDG_CURRENT_DESKTOP:-} ${XDG_SESSION_DESKTOP:-}"
current_desktop="${current_desktop,,}"
is_plasma_session=false
if [[ "$current_desktop" == *kde* || "$current_desktop" == *plasma* \
        || "${KDE_FULL_SESSION:-}" == "true" || "${KDE_SESSION_VERSION:-}" =~ ^[0-9]+$ ]]; then
    is_plasma_session=true
elif command -v pgrep >/dev/null 2>&1 && pgrep -x plasmashell >/dev/null 2>&1; then
    is_plasma_session=true
fi

js_quote() {
    local value="${1-}"
    value=${value//\\/\\\\}
    value=${value//\'/\\\'}
    value=${value//$'\n'/\\n}
    value=${value//$'\r'/\\r}
    value=${value//$'\t'/\\t}
    printf '%s' "$value"
}

apply_plasma_to_screen() {
    local dbus_command="" image_path_js="" script="" output=""
    if command -v qdbus6 >/dev/null 2>&1; then
        dbus_command="$(command -v qdbus6)"
    elif command -v qdbus >/dev/null 2>&1; then
        dbus_command="$(command -v qdbus)"
    else
        printf 'set_wallpaper: per-monitor Plasma mode requires qdbus6 or qdbus; refusing to change all screens\n' >&2
        return 127
    fi

    image_path_js="$(js_quote "$image")"
    script="var targetScreenIndex = ${screen_index};
var targetDesktop = desktopForScreen(targetScreenIndex);
if (!targetDesktop || Number(targetDesktop.screen) !== targetScreenIndex) {
    print('WALLPAPER_SET_ERROR: target screen was not found');
} else {
    var encodedPath = '${image_path_js}'.split('/').map(function(part) { return encodeURIComponent(part); }).join('/');
    targetDesktop.wallpaperPlugin = 'org.kde.image';
    targetDesktop.currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
    targetDesktop.writeConfig('Image', 'file://' + encodedPath);
    print('WALLPAPER_SET_OK');
}"

    if ! output="$("$dbus_command" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$script" 2>&1)"; then
        printf 'set_wallpaper: Plasma D-Bus request failed: %s\n' "$output" >&2
        return 1
    fi
    if [[ "$output" != *"WALLPAPER_SET_OK"* ]]; then
        printf 'set_wallpaper: Plasma did not confirm the selected monitor update: %s\n' "$output" >&2
        return 1
    fi
}

if [[ "$is_plasma_session" == true ]]; then
    apply_plasma_to_screen
    exit $?
fi

if command -v swww >/dev/null 2>&1; then
    exec swww img --outputs "$output_name" "$image"
fi

printf 'set_wallpaper: no per-monitor backend found; Plasma requires qdbus6/qdbus, Niri/Wayland requires swww with swww-daemon running\n' >&2
exit 127
