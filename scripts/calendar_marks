#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/env"
command -v flock >/dev/null 2>&1 || {
  printf 'calendar_marks: flock is required for safe mark updates\n' >&2
  exit 1
}
command -v jq >/dev/null 2>&1 || {
  printf 'calendar_marks: jq is required for JSON updates\n' >&2
  exit 1
}
# Re-read the path after taking its lock so an operation queued during a
# storage relocation follows the newly selected file instead of writing the
# previous location.
while :; do
  FILE="${QS_CALENDAR_MARKS_FILE}"
  CFG_DIR="${FILE%/*}"
  [[ -n "$CFG_DIR" ]] || CFG_DIR="/"
  LOCK="$CFG_DIR/.calendar-marks.lock"
  mkdir -p "$CFG_DIR"
  exec {lock_fd}>"$LOCK"
  flock -x "$lock_fd"
  previous_file="$FILE"
  qs_refresh_storage_file_paths
  if [[ "${QS_CALENDAR_MARKS_FILE}" == "$previous_file" ]]; then break; fi
  flock -u "$lock_fd"
  exec {lock_fd}>&-
done

: > "$CFG_DIR/.migration-calendar-marks-v1"
chmod 600 "$CFG_DIR/.migration-calendar-marks-v1" 2>/dev/null || true

if [[ ! -f "$FILE" ]]; then
  init_tmp="$(mktemp "$CFG_DIR/.calendar-marks-init.XXXXXX")"
  if ! printf '{}\n' > "$init_tmp"; then
    rm -f -- "$init_tmp"
    exit 1
  fi
  chmod 600 "$init_tmp" 2>/dev/null || true
  if ! mv -n -- "$init_tmp" "$FILE"; then
    rm -f -- "$init_tmp"
    exit 1
  fi
  rm -f -- "$init_tmp"
fi

case "${1:-get}" in
  get)
    jq -e 'if type == "object" then with_entries(select(.value == true)) else {} end' "$FILE"
    ;;
  set)
    key="${2:-}"
    enabled="${3:-}"
    if [[ ! "$key" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || [[ "$(date -d "$key" +%F 2>/dev/null || true)" != "$key" ]]; then
      echo "Invalid date key; expected a real date in YYYY-MM-DD format" >&2
      exit 2
    fi
    case "$enabled" in
      true|1|yes) enabled=true ;;
      false|0|no) enabled=false ;;
      *) echo "Invalid mark state; expected true or false" >&2; exit 2 ;;
    esac
    if ! jq -e 'type == "object"' "$FILE" >/dev/null 2>&1; then
      printf 'calendar_marks: existing calendar marks file is not a valid JSON object; refusing to overwrite it\n' >&2
      exit 1
    fi
    tmp="$(mktemp "$CFG_DIR/.calendar-marks.XXXXXX")"
    cleanup_calendar_marks_tmp() { [[ -z "${tmp:-}" ]] || rm -f -- "$tmp"; }
    trap cleanup_calendar_marks_tmp EXIT
    if [[ "$enabled" == true ]]; then
      jq --arg key "$key" '.[$key] = true' "$FILE" > "$tmp"
    else
      jq --arg key "$key" 'del(.[$key])' "$FILE" > "$tmp"
    fi
    chmod 600 "$tmp" 2>/dev/null || true
    mv -f -- "$tmp" "$FILE"
    tmp=""
    trap - EXIT
    ;;
  *)
    echo "Usage: $0 {get|set YYYY-MM-DD true|false}" >&2
    exit 2
    ;;
esac
